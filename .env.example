# Copy this file to .env (it is ignored by git) and start the server with: node --env-file=.env build/app
# Generate a new key with: openssl genrsa -out encryptionkeys/jwt.key 2048
# Use one of the two variables:
JWT_PRIVATE_KEY_FILE=encryptionkeys/jwt.key
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
